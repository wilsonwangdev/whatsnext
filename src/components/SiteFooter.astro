---
import { NAV, SITE } from '../data/site';
import { withBase } from '../lib/paths';

const buildDate = new Date();
const y = buildDate.getUTCFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__grid">
      <div>
        <h2>关于</h2>
        <p>
          {SITE.nameZh}是一个公开档案，记录开发者软件与开源项目的收购、团队加入，以及交易之后产品、
          团队和开源承诺的实际走向。每条核心事实都链接到公开来源，并标注核验日期。
        </p>
      </div>
      <div>
        <h2>目录</h2>
        <ul>
          {NAV.map((item) => (
            <li><a href={withBase(item.href)}>{item.label} · {item.en}</a></li>
          ))}
          <li><a href={withBase('/contribute')}>贡献指南</a></li>
          <li><a href={withBase('/cases.json')}>数据导出</a></li>
        </ul>
      </div>
      <div>
        <h2>规则</h2>
        <ul>
          <li><a href={withBase('/method#evidence')}>证据等级</a></li>
          <li><a href={withBase('/method#corrections')}>纠错流程</a></li>
          <li><a href={withBase('/method#license')}>内容许可</a></li>
          <li><a href={withBase('/rss.xml')}>RSS 订阅</a></li>
          <li><a href={withBase('/status')}>核验状态</a></li>
        </ul>
      </div>
    </div>
    <div class="site-footer__bottom">
      <span>
        © {y} {SITE.name} · 内容 CC BY-SA 4.0 · 代码 MIT ·
        <a href={SITE.repo} target="_blank" rel="noopener">源码在 GitHub</a>
      </span>
      <span>不构成投资建议 · 所有事实以来源为准</span>
      <span>构建于 {buildDate.toISOString().slice(0, 10)}</span>
    </div>
  </div>
</footer>
