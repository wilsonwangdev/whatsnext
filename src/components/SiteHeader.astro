---
import { NAV, SITE } from '../data/site';
import { BASE, withBase } from '../lib/paths';

const base = BASE.endsWith('/') ? BASE.slice(0, -1) : BASE;
const path = Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length) || '/'
  : Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href={withBase('/')} aria-label={`${SITE.name} 首页`}>
      <svg class="brand__mark" viewBox="0 0 26 26" fill="none" aria-hidden="true">
        <rect x="0.5" y="0.5" width="25" height="25" stroke="currentColor" />
        <path d="M0.5 0.5L25.5 25.5" stroke="currentColor" stroke-width="0.75" />
        <path class="mark-accent" d="M13 0.5H25.5V13L13 0.5Z" />
        <path d="M13 25.5H0.5V13L13 25.5Z" stroke="currentColor" stroke-width="0.75" />
      </svg>
      <span class="brand__text">
        <span class="brand__name">{SITE.name}</span>
        <span class="brand__sub">{SITE.nameZh} · Archive</span>
      </span>
    </a>

    <div class="header-actions">
    <nav class="site-nav" aria-label="主导航">
      {NAV.map((item) => (
        <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
      <a href={withBase('/contribute')} class="nav-contribute">参与</a>
    </nav>
      <a
        class="gh-link"
        href={SITE.repo}
        target="_blank"
        rel="noopener"
        aria-label={`在 GitHub 上查看 ${SITE.name} 源码`}
      >
        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" width="17" height="17">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
        </svg>
      </a>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换深色模式">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" />
          <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.2 5.2l1.6 1.6M17.2 17.2l1.6 1.6M18.8 5.2l-1.6 1.6M6.8 17.2l-1.6 1.6" />
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M20 14.5A8.2 8.2 0 0 1 9.5 4a8.3 8.3 0 1 0 10.5 10.5Z" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;
  const sync = () => {
    if (btn) {
      btn.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
      btn.setAttribute('aria-label', root.dataset.theme === 'dark' ? '切换浅色模式' : '切换深色模式');
    }
  };
  btn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('whatsnext-theme', next);
    } catch {
      /* ignore */
    }
    sync();
  });
  sync();
</script>
